# ==============================================================================
# ELMO AI OPERATING SYSTEM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or real secret keys to source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database & Authentication)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 2. Gemini Intelligence Model (Executive Brain)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. Voice Operating System (Phase 3 Core)
# ------------------------------------------------------------------------------
VOICE_ENABLED=true
VOICE_REALTIME_ENABLED=true
VOICE_REALTIME_PROVIDER=gemini-live
VOICE_LANGUAGE_MODE=auto
VOICE_LANGUAGE=auto
VOICE_STT_PROVIDER=browser
VOICE_TTS_PROVIDER=browser
VOICE_VAD_PROVIDER=browser

VOICE_AUTO_LISTEN=true
VOICE_AUTO_SPEAK=true
VOICE_INTERRUPT_ENABLED=true

VOICE_SESSION_TIMEOUT_MS=300000
VOICE_SILENCE_TIMEOUT_MS=1200
VOICE_MAX_SPEECH_DURATION_MS=60000
VOICE_MAX_RESPONSE_DURATION_MS=120000
VOICE_RECONNECT_MAX_RETRIES=3
VOICE_RECONNECT_BACKOFF_MS=1000

# ------------------------------------------------------------------------------
# 4. Speech-to-Text (STT) Provider (Optional Custom Provider)
# ------------------------------------------------------------------------------
VOICE_STT_API_KEY=
VOICE_STT_API_URL=

# ------------------------------------------------------------------------------
# 5. Text-to-Speech (TTS) Provider (Optional Custom Provider)
# ------------------------------------------------------------------------------
VOICE_TTS_API_KEY=
VOICE_TTS_API_URL=
VOICE_TTS_VOICE_ID=
VOICE_TTS_MODEL=

# ------------------------------------------------------------------------------
# 6. Voice Activity Detection (VAD) Tuning
# ------------------------------------------------------------------------------
VOICE_VAD_THRESHOLD=
VOICE_VAD_SILENCE_DURATION_MS=1500
VOICE_VAD_MIN_SPEECH_DURATION_MS=250
VOICE_VAD_MAX_SPEECH_DURATION_MS=60000

# ------------------------------------------------------------------------------
# 7. Application & Client Flags
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_VOICE_ENABLED=true
